generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TrainingMode {
  ONLINE
  OFFLINE
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model Lead {
  id        String       @id @default(cuid())
  name      String
  phone     String
  email     String?
  goal      String
  mode      TrainingMode
  message   String?
  status    LeadStatus   @default(NEW)
  createdAt DateTime     @default(now())

  @@index([status, createdAt])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  quote     String
  goal      String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([approved, createdAt])
}
